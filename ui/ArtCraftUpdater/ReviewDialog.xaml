<Window x:Class="ArtCraftUpdater.Wpf.ReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review update" Width="560" Height="420"
        MinWidth="480" MinHeight="320"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="28,24,28,24">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HeadingText}"
               FontSize="20" Text="Review update"/>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubheaderText}"
               Text="Confirming records your approval only. Installing happens separately and only after its own confirmation."/>
    <ListBox x:Name="ReviewList" DockPanel.Dock="Top" Margin="0,16,0,0" MaxHeight="220"
             Background="Transparent" BorderThickness="0" IsTabStop="False">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,0,0,8">
            <TextBlock FontFamily="{StaticResource AppFontFamily}" FontSize="14"
                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
              <Run Text="{Binding Name}"/><Run Text="  "/><Run Text="{Binding InstalledVersion}"/>
              <Run Text=" -> "/><Run Text="{Binding LatestVersion}"/>
            </TextBlock>
            <TextBlock FontFamily="{StaticResource AppFontFamily}" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" Text="{Binding StatusText}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="WarningsText" DockPanel.Dock="Top" Margin="0,8,0,0"
               FontFamily="{StaticResource AppFontFamily}" FontSize="12"
               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
               Visibility="Collapsed"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
              TabIndex="1" Margin="0,0,10,0" IsCancel="True"/>
      <Button x:Name="ConfirmButton" Content="Confirm" Style="{StaticResource PrimaryButton}"
              TabIndex="0" IsDefault="True"/>
    </StackPanel>
  </DockPanel>
</Window>
