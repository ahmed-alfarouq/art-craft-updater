<UserControl x:Class="ArtCraftUpdater.Wpf.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}" Padding="28,24,28,24">
  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
          Padding="0,0,0,16">
    <!-- justify-content: space-between equivalent: left content column,
         right button column pinned to the far edge at any window width. -->
    <Grid VerticalAlignment="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
        <TextBlock Text="Updates" Style="{StaticResource HeadingText}"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ProgressBar x:Name="CheckingSpinner" Width="120" Height="4" Margin="0,0,8,0"
                       VerticalAlignment="Center" IsIndeterminate="True"
                       Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                       Background="Transparent" BorderThickness="0"/>
          <TextBlock x:Name="SubheaderText" Style="{StaticResource SubheaderText}"
                     Text="1 update available &#183; last checked today at 22:11"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                  HorizontalAlignment="Right">
        <Button x:Name="CheckAgainButton" Style="{StaticResource SecondaryButton}"
                TabIndex="0" Margin="0,0,0,0" ToolTip="Check again">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE72C;"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                       VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Refresh"/>
            <TextBlock Text="Check again" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="UpdateSelectedButton" Content="Update selected" Style="{StaticResource SecondaryButton}"
                TabIndex="1" Margin="10,0,0,0" ToolTip="Update selected"/>
        <Button x:Name="UpdateAllButton" Content="Update all" Style="{StaticResource PrimaryButton}"
                TabIndex="2" Margin="10,0,0,0" ToolTip="Update all"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
