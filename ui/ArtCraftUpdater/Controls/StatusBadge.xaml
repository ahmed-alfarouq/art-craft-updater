<UserControl x:Class="ArtCraftUpdater.Wpf.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <Border x:Name="Pill" CornerRadius="10" Padding="10,4,10,4"
          Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <TextBlock x:Name="Label" FontFamily="{StaticResource AppFontFamily}" FontSize="12"
               Foreground="{StaticResource TextSecondaryBrush}"
               VerticalAlignment="Center" Text="Unknown"/>
  </Border>
</UserControl>
