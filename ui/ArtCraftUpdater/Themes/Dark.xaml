<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Design tokens: exact values from the supplied specification. -->
  <Color x:Key="WindowBackgroundColor">#0F1115</Color>
  <Color x:Key="TitleBarColor">#14171C</Color>
  <Color x:Key="TitleBarBorderColor">#22262E</Color>
  <Color x:Key="SurfaceColor">#181B21</Color>
  <Color x:Key="BorderColor">#272B34</Color>
  <Color x:Key="SelectedRowColor">#1C2230</Color>
  <Color x:Key="TextPrimaryColor">#E7E9EE</Color>
  <Color x:Key="TextSecondaryColor">#C5CAD3</Color>
  <Color x:Key="MutedColor">#9AA1AE</Color>
  <Color x:Key="AccentColor">#6AA5FF</Color>
  <Color x:Key="TextOnAccentColor">#0B1220</Color>
  <Color x:Key="SuccessColor">#6EE0A8</Color>
  <Color x:Key="SuccessBackgroundColor">#16301F</Color>
  <Color x:Key="WarningColor">#F5C26B</Color>
  <Color x:Key="WarningBackgroundColor">#3A2D12</Color>
  <Color x:Key="WindowBorderColor">#2A2E37</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
  <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}"/>
  <SolidColorBrush x:Key="TitleBarBorderBrush" Color="{StaticResource TitleBarBorderColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="SelectedRowBrush" Color="{StaticResource SelectedRowColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessBackgroundColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}"/>

  <sys:Double x:Key="CardCornerRadiusValue">12</sys:Double>
  <CornerRadius x:Key="CardCornerRadius">12,12,12,12</CornerRadius>
  <CornerRadius x:Key="ButtonCornerRadius">8,8,8,8</CornerRadius>

  <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

  <Style x:Key="HeadingText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="SubheaderText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
  </Style>

  <!-- Keyboard focus: 2px outline with 2px offset. -->
  <Style x:Key="SecondaryFocusRing" TargetType="Control">
    <Setter Property="FocusVisualStyle">
      <Setter.Value>
        <Style>
          <Setter Property="Control.Template">
            <Setter.Value>
              <ControlTemplate>
                <Rectangle Margin="-4" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryFocusRing" TargetType="Control">
    <Setter Property="FocusVisualStyle">
      <Setter.Value>
        <Style>
          <Setter Property="Control.Template">
            <Setter.Value>
              <ControlTemplate>
                <Rectangle Margin="-4" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary button: #232730 bg, #343945 border, #E7E9EE text. -->
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryFocusRing}">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="18,0,18,0"/>
    <Setter Property="Background" Value="#232730"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="#343945"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource ButtonCornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True"/>
          <Condition Property="IsEnabled" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="#2A2F3A"/>
        <Setter Property="BorderBrush" Value="#3F4552"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsPressed" Value="True"/>
          <Condition Property="IsEnabled" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="#1D2027"/>
        <Setter Property="BorderBrush" Value="#343945"/>
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="#1A1D23"/>
        <Setter Property="BorderBrush" Value="#272B34"/>
        <Setter Property="Foreground" Value="#5B6270"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Primary button: #6AA5FF bg+border, #0B1220 text. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryFocusRing}">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="18,0,18,0"/>
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource ButtonCornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True"/>
          <Condition Property="IsEnabled" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="#85B6FF"/>
        <Setter Property="BorderBrush" Value="#85B6FF"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsPressed" Value="True"/>
          <Condition Property="IsEnabled" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="#4F90F0"/>
        <Setter Property="BorderBrush" Value="#4F90F0"/>
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="#26324A"/>
        <Setter Property="BorderBrush" Value="#26324A"/>
        <Setter Property="Foreground" Value="#6F7A90"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
